{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "Modules/**/*.ts",
    "middlewares/**/*.ts",
    "Helper/**/*.ts",
    "src/prisma/db.ts",
    "src/prisma/contract.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "migrations",
    "prisma.config.ts",
    "neon.ts",
    "hello.ts",
    "src/prisma/seed.ts",
    ".agents",
    ".claude",
    ".cursor",
    ".devin"
  ]
}
